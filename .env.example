# =============================================================================
# AI QUIZ GAME - BACKEND ENVIRONMENT
# =============================================================================
# Copy this file to backend/.env, then replace the API-key placeholders below.
# The backend loads backend/.env on startup via python-dotenv.
# Restart FastAPI after changing this file.
#
# Never commit backend/.env or share real API keys. Keep this example key-free.
# IMPORTANT: This configuration matches the current code on
# feature/quiz-web-foundation (reviewed at commit 8b085c4).
#
# Current limitation: the Quality Checker uses the SAME provider and model as
# the generator. Dedicated reviewer settings are shown near the end as TODOs;
# they will work only after the corresponding code change is implemented.
# =============================================================================


# =============================================================================
# 1. ACTIVE GENERATION PROVIDER
# =============================================================================
# Available values: nvidia | openai | bedrock
# Only the selected provider is used to generate questions.
LLM_PROVIDER=nvidia


# =============================================================================
# 2. NVIDIA (CURRENT GENERATOR)
# =============================================================================
# Create an NVIDIA API key at https://build.nvidia.com/settings/api-keys
# NVIDIA uses an OpenAI-compatible API, but model-specific features can differ.
NVIDIA_API_KEY=REPLACE_WITH_NVIDIA_API_KEY

# Main model: generates questions in the current setup.
# Check the model catalog before changing model IDs; deployments can be retired.
NVIDIA_MODEL_ID=nvidia/nemotron-3-super-120b-a12b

# Reserve model (informational only).
# The current application DOES NOT switch to this model automatically on 429/503.
# If you need manual fallback, change NVIDIA_MODEL_ID and restart the backend.
# This is NOT yet a separate Quality Checker model setting.
NVIDIA_FALLBACK_MODEL_ID=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning


# =============================================================================
# 3. OPENAI (ALTERNATIVE PROVIDER; NOT USED WHILE LLM_PROVIDER=nvidia)
# =============================================================================
# Create an API key at https://platform.openai.com/api-keys
# API requests may be billable. The selected model must support the request
# parameters (including reasoning and Structured Outputs when enabled).
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
OPENAI_MODEL_ID=gpt-5.6-luna


# =============================================================================
# 4. AWS BEDROCK (ALTERNATIVE PROVIDER; NOT USED WHILE LLM_PROVIDER=nvidia)
# =============================================================================
# Use credentials with permission to invoke the selected Bedrock model.
# Prefer an IAM role/temporary credentials where available. For local development,
# the AWS SDK also supports credentials configured outside this .env file.
# A valid key does not itself guarantee access to a particular Bedrock model.
AWS_ACCESS_KEY_ID=REPLACE_WITH_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_AWS_SECRET_ACCESS_KEY

# Select a region that supports your selected model/inference profile.
AWS_REGION=us-east-1

# Nova 2 Lite cross-region inference profile. Verify availability and access
# in your AWS account before selecting Bedrock as the active provider.
BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0


# =============================================================================
# 5. GENERATION TIMEOUTS AND RETRY POLICY
# =============================================================================
# SDK automatic retries are disabled. The application has ONE shared loop for
# provider errors, invalid generated questions, and quality regeneration.
# A quality review may add one more provider request within each attempt.
# The budget is soft, not a guaranteed wall-clock cancellation deadline.

# Provider socket timeout (seconds; per provider request, subject to budget).
AI_PROVIDER_TIMEOUT_SECONDS=12

# Maximum application attempts, including the first attempt.
AI_GENERATION_MAX_ATTEMPTS=3

# Soft overall generation + review budget (seconds).
AI_GENERATION_BUDGET_SECONDS=30

# Exponential backoff with jitter: base and maximum seconds.
AI_RETRY_BACKOFF_BASE_SECONDS=0.5
AI_RETRY_BACKOFF_MAX_SECONDS=2


# =============================================================================
# 6. STRUCTURED OUTPUTS: QUESTION GENERATOR
# =============================================================================
# off    = request ordinary text; parse JSON and validate with Pydantic.
# strict = send the question JSON Schema through provider-native parameters.
# Previously verified locally with the current NVIDIA Super model + guided_json.
AI_STRUCTURED_OUTPUT_MODE=strict

# NVIDIA-specific schema format, used in strict mode only:
# guided_json | json_schema
# The selected NVIDIA deployment must support the chosen format.
# Unsupported parameters do NOT trigger an automatic fallback.
NVIDIA_STRUCTURED_OUTPUT_FORMAT=guided_json


# =============================================================================
# 7. OPTIONAL AI QUALITY CHECKER
# =============================================================================
# off     = no reviewer call; the existing generator pipeline only.
# audit   = reviewer evaluates each valid candidate and logs safe verdict codes,
#           but DOES NOT prevent a problematic question from reaching the player.
# enforce = reviewer may reject a question; avoid until audit results are evaluated.
#
# audit/enforce incur another AI request per structurally valid candidate.
# IMPORTANT: in the CURRENT code, the reviewer uses LLM_PROVIDER and its model.
# With this file, both generator and reviewer use Nemotron Super 120B.
AI_QUALITY_MODE=audit

# ------------------------ PLANNED, NOT IMPLEMENTED ----------------------------
# These variables DO NOT yet affect the application. Keep them commented out
# until the separate reviewer-provider/model/format selection is implemented.
# Desired future setup: Super generates; Nano reviews.
#
# AI_QUALITY_PROVIDER=nvidia
# AI_QUALITY_MODEL_ID=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# AI_QUALITY_STRUCTURED_OUTPUT_MODE=off
#
# NOTE: AI_QUALITY_STRUCTURED_OUTPUT_MODE=off would allow the reviewer to output
# prompt-guided JSON without native schema, while the generator remains strict.
# Until that feature exists, AI_STRUCTURED_OUTPUT_MODE=strict applies to BOTH
# the question and the review contracts.
# -----------------------------------------------------------------------------


# =============================================================================
# 8. BROWSER / FRONTEND WAITING POLICY
# =============================================================================
# These values are served to Angular by GET /api/client-config.
# A warning appears after QUIZ_LONG_WAIT_WARNING_SECONDS.
# The browser aborts waiting after QUIZ_HTTP_TIMEOUT_SECONDS; a synchronous
# provider request already running on the server may still finish afterward.
QUIZ_LONG_WAIT_WARNING_SECONDS=8
QUIZ_HTTP_TIMEOUT_SECONDS=45
