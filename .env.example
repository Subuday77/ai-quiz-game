# OpenAI API key (paid). https://platform.openai.com/api-keys
OPENAI_API_KEY=your-key-here
# A GPT-5.6 model, e.g. gpt-5.6-luna (the cheapest) — it can switch reasoning off
# (reasoning_effort="none"), which 06a relies on. gpt-6-astra and gpt-5/-mini can't.
OPENAI_MODEL_ID=your-model-id

# AWS access key for the IAM user/role with bedrock:InvokeModel permission.
# Generate in IAM console → Users → Security credentials → "Create access key".
AWS_ACCESS_KEY_ID=your-key-here

# AWS secret access key paired with AWS_ACCESS_KEY_ID. Shown once at creation.
AWS_SECRET_ACCESS_KEY=your-secret-here

# AWS region for Bedrock calls. us-east-1 has the broadest model availability;
# us-west-2 is the other common choice. Must match a region where you've been
# granted access to BEDROCK_MODEL_ID.
AWS_REGION=us-east-1

# Bedrock model ID for the default LLM call across labs.
# Find current IDs in the Bedrock console: Discover → Model catalog →
# filter by Amazon → click "Nova 2 Lite". Use the cross-region inference-profile
# ID (the `us.` one below), NOT the bare `amazon.nova-2-lite-v1:0`: Nova 2 Lite
# isn't callable in-region on-demand in us-east-1, so a profile prefix is
# required. (`eu.` / `jp.` / `global.` profiles exist for other regions.)
# fast, cheap reasoning model (course default)
BEDROCK_MODEL_ID=your-bedrock-model-id
# Nova 2 Pro is preview-only as of this writing — add it here once it's GA in your account.

# NVIDIA API key (starts with nvapi-) — free for prototyping, no credit card.
# Used by exercise 01 (the raw-HTTP call) and the 06a/06b gateway. NVIDIA hosts
# open models behind an OpenAI-compatible API. Sign in, then "Generate API Key" at:
#   https://build.nvidia.com/settings/api-keys
NVIDIA_API_KEY=your-key-here

# NVIDIA model ID — the course default. Copy IDs from a model's code sample on
# build.nvidia.com/models. NVIDIA retires models on a schedule (a retired ID
# answers 410 Gone), so check it still answers before a class.
NVIDIA_MODEL_ID=your-model-id

# NVIDIA fallback model. No lab reads this automatically — when the default is
# overloaded (503) or you've hit its limit (429), copy this into NVIDIA_MODEL_ID.
# Rate limits are per model (~40 requests/minute each), so a second model has
# its own allowance. Fast, and its tool calls and JSON output held up in testing.
NVIDIA_FALLBACK_MODEL_ID=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# Choose the LLM provider from the list: openai, nvidia, bedrock.
# You nay add more providers but you will need to add their settings in define_ai_provider.py file
LLM_PROVIDER=openai