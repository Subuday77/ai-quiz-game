# Private production environment. Copy to .env, chmod 600, and fill secrets.
# NEVER commit populated .env. Password must use URL-safe characters (hex works).
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_HEX_PASSWORD
OPENAI_API_KEY=REPLACE_WITH_SECRET

# Approved quiz models. Reconcile with your tested local configuration before launch.
# New appeal parser name: KEDDY (legacy CADDY_* accepted only during migration).
LLM_PROVIDER=openai
OPENAI_MODEL_ID=gpt-5.4
QUIZ_HELPER_MODEL_ID=gpt-5.4
QUIZ_COMPLAINT_KEDDY_MODEL_ID=gpt-6-luna
QUIZ_COMPLAINT_JUDGE_MODEL_ID=gpt-6.1-sol

# Existing Render service. The Localizer controls and caches UI translations.
AI_LOCALIZER_BASE_URL=https://ai-localizer-api.onrender.com

# Only add tested quality/dedup settings after comparing with local .env.
# AI_QUALITY_MODE=enforce
# AI_QUALITY_CONTRACT=v2
# AI_TAG_DEDUP_ENABLED=true

# Public launch: replace YOUR_DOMAIN with your actual DNS name; require HTTPS.
AUTH_ALLOWED_ORIGINS=https://YOUR_DOMAIN
AUTH_COOKIE_SECURE=true

# Private SSH-tunnel staging ONLY (HTTP on localhost:8080, no public listener):
# AUTH_ALLOWED_ORIGINS=http://localhost:8080
# AUTH_COOKIE_SECURE=false
# Before public launch revert to HTTPS values above.

# Conservative initial rollout: DB First remains disabled pending live QA.
QUIZ_DB_FIRST_GENERATION=false
QUIZ_QUALITY_SKILL_MODE=shadow
