# AI Quiz Game — FULL server-side deployment profile (explicit defaults).
#
# Copy ONCE to the repository root .env for a NEW installation. On an existing
# VPS, merge missing nonsecret settings without overwriting live .env/secrets.
# NEVER commit a populated .env. chmod 600 .env; protect backups.
# Docker Compose sets DATABASE_URL for backend from POSTGRES_PASSWORD, DB service
# name and database name; DO NOT add a separate DATABASE_URL on the VPS.
# This profile intentionally matches .env.example except transport, secrets,
# Render Localizer and the approved DB First rollout. Do not expose in Angular.
# A pre-existing database must complete tagging.backfill --dry-run to 0 missing
# BEFORE tagged dedup is enabled. Review runtime using:
# docker compose exec -T backend python -m scripts.audit_runtime_guards --strict.

# =============================================================================
# 1. REQUIRED CONNECTIONS / AUTH
# =============================================================================
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_HEX_PASSWORD
OPENAI_API_KEY=REPLACE_WITH_SECRET

# Production requires HTTPS and secure cookies; replace YOUR_DOMAIN.
AUTH_COOKIE_SECURE=true
AUTH_ALLOWED_ORIGINS=https://YOUR_DOMAIN
# PRIVATE SSH-tunnel staging ONLY, web bound to 127.0.0.1:8080:
# AUTH_COOKIE_SECURE=false
# AUTH_ALLOWED_ORIGINS=http://localhost:8080
# Restore HTTPS and secure cookies before public launch.

# =============================================================================
# 2. GENERATOR / MAIN QUALITY CRITIC
# =============================================================================
LLM_PROVIDER=openai
OPENAI_MODEL_ID=gpt-5.4
AI_GENERATOR_PROMPT_VERSION=v1
AI_STRUCTURED_OUTPUT_MODE=strict
AI_LOCAL_LEAK_MODE=enforce

# With tagged questions, v5 verification runs regardless of this flag.
# enforce activates weighted editorial rejection and Terra arbitration.
AI_QUALITY_MODE=enforce
# Used by the legacy (non-tagged) reviewer; tagged v5 has its own contract.
AI_QUALITY_CONTRACT=v2
AI_QUALITY_PROVIDER=openai
AI_QUALITY_MODEL_ID=gpt-5.4-mini
AI_QUALITY_STRUCTURED_OUTPUT_MODE=strict

AI_PROVIDER_TIMEOUT_SECONDS=12
AI_GENERATION_MAX_ATTEMPTS=3
AI_GENERATION_BUDGET_SECONDS=30
# Q13–Q16: 60s for each of up to two vetted-category generation cycles.
# Q1–Q12 still use the 30s baseline.
AI_LATE_GAME_BUDGET_SECONDS=60
AI_CRITIC_MIN_REMAINING_SECONDS=8
AI_RETRY_BACKOFF_BASE_SECONDS=0.5
AI_RETRY_BACKOFF_MAX_SECONDS=2

# =============================================================================
# 3. DEDUPLICATION, QUESTION POOL, LOCAL QUALITY TOOLS, TERRA ARBITRATION
# =============================================================================
# Requires tagged-v5 DB metadata/backfill and current Alembic migrations.
AI_TAG_DEDUP_ENABLED=true
QUIZ_TAG_DUPLICATE_SCORE_THRESHOLD=70
QUIZ_QUESTION_POOL_FALLBACK_ENABLED=true
QUIZ_QUESTION_POOL_SCAN_LIMIT=100
QUIZ_TOO_EASY_ONLY_FALLBACK_ENABLED=true

# shadow = run deterministic quality tools; the arbiter below can act only
# when AI_QUALITY_MODE=enforce and the question needs arbitration.
QUIZ_QUALITY_SKILL_MODE=shadow
QUIZ_QUALITY_ARBITER_MODE=on
QUIZ_QUALITY_ARBITER_MODEL_ID=gpt-6.1-terra
QUIZ_QUALITY_ARBITER_TIMEOUT_SECONDS=10
# Safety exception: tagged ENFORCE questions with named north/south/east/west
# comparisons require Terra verification even when generic arbitration is off.
# No extra call for DB First hits or for questions without such comparisons.
QUIZ_QUALITY_ARBITRATION_MIN_SEVERITY=2
QUIZ_QUALITY_ARBITRATION_MIN_CONFIDENCE=0.55

# Editorial scoring — all of these variables are supported by
# backend/tagging/quality_skill/config.py. Defaults are explicit here so
# changes can be reviewed without hunting through Python modules.
QUIZ_QUALITY_SCORE_THRESHOLD=3.25
QUIZ_QUALITY_DISTRACTORS_WEIGHT=1.0
QUIZ_QUALITY_EARLY_DISTRACTORS_WEIGHT=0.5
QUIZ_QUALITY_SUITABILITY_WEIGHT=1.0
QUIZ_QUALITY_WORDING_WEIGHT=1.0
QUIZ_QUALITY_KNOWLEDGE_UNIT=0.25
QUIZ_QUALITY_KNOWLEDGE_CAP=0.5
QUIZ_QUALITY_TOO_HARD_UNIT=0.25
QUIZ_QUALITY_TOO_HARD_CAP=0.5
QUIZ_QUALITY_TOO_EASY_UNIT_START=0.25
QUIZ_QUALITY_TOO_EASY_UNIT_END=1.5
QUIZ_QUALITY_TOO_EASY_CAP_START=0.5
QUIZ_QUALITY_TOO_EASY_CAP_END=3.0
QUIZ_QUALITY_TOO_EASY_CURVE=1.5

# Deterministic local quality-tool thresholds
QUIZ_QUALITY_LEXICAL_PENALTY_WEIGHT=3.0
QUIZ_QUALITY_TAXONOMY_PENALTY_WEIGHT=3.0
QUIZ_QUALITY_FACT_PENALTY_WEIGHT=3.0
QUIZ_QUALITY_LEXICAL_MIN_PREFIX=5
QUIZ_QUALITY_LEXICAL_MIN_SHARED_FRACTION=0.8

# =============================================================================
# 4. PLATINUM HELPER — game and live QA now use these SAME values
# =============================================================================
QUIZ_HELPER_MODEL_ID=gpt-5.4
QUIZ_HELPER_REASONING_EFFORT=low
QUIZ_HELPER_MAX_OUTPUT_TOKENS=240
QUIZ_HELPER_TIMEOUT_SECONDS=8
# Helper responder calls the model ONCE; failed/unsafe replies use local templates.

# Cautious wrong-answer plausibility cutoffs, for difficulty bands 0, 1–3,
# 4–15. Below the corresponding cutoff, MISTAKEN -> UNSURE before the LLM call.
QUIZ_HELPER_PLAUSIBILITY_LEVEL_0=40
QUIZ_HELPER_PLAUSIBILITY_LEVELS_1_3=50
QUIZ_HELPER_PLAUSIBILITY_LEVELS_4_15=60

# Sensitive diagnostics (correct answers and character skills); local QA only.
QUIZ_HELPER_DEBUG=false

# =============================================================================
# 5. FRONTEND WAITING / OPTIONAL LOCALIZER / DIAGNOSTICS
# =============================================================================
QUIZ_LONG_WAIT_WARNING_SECONDS=15
QUIZ_HTTP_TIMEOUT_SECONDS=45
# Browser Q13–Q16 timeout accommodates 2 x 60s server generation + DB.
QUIZ_LATE_QUESTION_TIMEOUT_SECONDS=140

# Backend connects to an existing AI Localizer service (URL without /translate).
# Empty means cached translations / English fallback only.
AI_LOCALIZER_BASE_URL=https://ai-localizer-api.onrender.com
LOCALIZATION_RESET_ENABLED=false

# Include full candidate/critic details only during private local QA.
AI_GENERATION_DEBUG=false

# =============================================================================
# OPTIONAL PROVIDERS (NOT CONFIGURED)
# =============================================================================
# NVIDIA and AWS Bedrock integrations still exist in code but are not part of
# the active OpenAI setup. If intentionally changing LLM_PROVIDER and reviewer,
# configure their credentials/model IDs separately. We deliberately omit
# unused API-key placeholders and the obsolete NVIDIA_FALLBACK_MODEL_ID:
# it never triggered automatic fallback.

# =============================================================================
# 6. COMMUNITY QUESTION VOTES AND DB FIRST (SERVER-ONLY)
# Likes/dislikes are provisional in the browser and committed atomically with
# a successful answer. One immutable lifetime vote per user/question.
# Historical net never resets; working net resets only after an acquittal.
# DB First is explicitly enabled for the currently approved VPS test policy.
QUIZ_DB_FIRST_GENERATION=true
QUIZ_QUESTION_RATING_REVIEW_THRESHOLD=-15
QUIZ_QUESTION_FIRST_ACQUITTAL_SCORE=-5
QUIZ_QUESTION_SECOND_ACQUITTAL_SCORE=-10
QUIZ_QUESTION_MAX_REFERRALS=3
# Logistic probability to ADMIT an eligible DB question, not select it.
QUIZ_DB_FIRST_RATING_CENTER=0
QUIZ_DB_FIRST_RATING_SCALE=10

# =============================================================================
# 7. PLAYER APPEALS — KEDDY AND INDEPENDENT JUDGE
# =============================================================================
# Shared OPENAI_API_KEY. The adjudicator must differ from the stored question
# generator_model. Built-in backend scheduler handles durable appeal retries.
QUIZ_COMPLAINT_KEDDY_MODEL_ID=gpt-6-luna
QUIZ_COMPLAINT_KEDDY_REASONING_EFFORT=low
QUIZ_COMPLAINT_KEDDY_MAX_OUTPUT_TOKENS=800
QUIZ_COMPLAINT_KEDDY_TIMEOUT_SECONDS=12
QUIZ_COMPLAINT_JUDGE_MODEL_ID=gpt-6.1-sol
QUIZ_COMPLAINT_JUDGE_REASONING_EFFORT=medium
QUIZ_COMPLAINT_JUDGE_MAX_OUTPUT_TOKENS=1800
QUIZ_COMPLAINT_JUDGE_TIMEOUT_SECONDS=40


# Appeal diagnostics: INFO (production) or DEBUG (no raw personal/model texts)
QUIZ_COMPLAINT_LOG_LEVEL=INFO

# QA only: extra free complaint filings per user/month via grant_test_appeals.py
# NEVER enable in production. Disabled means original 5/month policy.
QUIZ_QA_APPEAL_CREDITS_ENABLED=false
