# Copy to .env on the VPS. Never commit the populated file.
# Choose a long random password containing URL-safe characters (letters/digits).
POSTGRES_PASSWORD=REPLACE_WITH_LONG_URL_SAFE_RANDOM_PASSWORD
OPENAI_API_KEY=REPLACE_WITH_SECRET

# Pin the actual production models before launch; validate against the current project config.
LLM_PROVIDER=openai
QUIZ_COMPLAINT_KEDDY_MODEL_ID=REVIEW_MODEL_ID
QUIZ_COMPLAINT_JUDGE_MODEL_ID=DIFFERENT_REVIEW_MODEL_ID

# Change to your final HTTPS domain, with no trailing slash.
AUTH_ALLOWED_ORIGINS=https://YOUR_DOMAIN
AUTH_COOKIE_SECURE=true

# Conservative initial rollout: DB First requires separate live E2E acceptance.
QUIZ_DB_FIRST_GENERATION=false
QUIZ_QUALITY_SKILL_MODE=shadow
